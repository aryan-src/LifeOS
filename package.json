{
  "name": "lifeos",
  "version": "1.0.0",
  "description": "Minimalist, zero-latency daily personal OS with academic planning, task tracking, finance management, habits, and notes.",
  "main": "index.js",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked > src/types/database.ts",
    "verify:rls": "node scripts/verify-phase-1.mjs"
  },
  "keywords": [
    "lifeos",
    "productivity",
    "tasks",
    "finance",
    "habits",
    "notes",
    "nextjs",
    "supabase"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@number-flow/react": "^0.6.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
